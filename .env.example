# Generate locally with: python3 scripts/setup-env.py
# Never commit .env or reuse these credentials elsewhere.
APP_KEY=
DB_PASSWORD=
AI_INTERNAL_SECRET=

# Integrated generation: paid calls remain disabled by default.
# Selected PUBLIC source is sent to the explicitly selected provider.
# store=false does not disable the provider's standard abuse monitoring retention.
LLM_REAL_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_CONTEXT_WINDOW=1047576
LLM_DATA_POLICY=standard-abuse-monitoring-30d
LLM_SOURCE_DISCLOSURE_ACKNOWLEDGED=false
# Integer micro-USD per million tokens; $0.40 input / $1.60 output.
LLM_INPUT_MICROUSD_PER_MILLION=400000
LLM_OUTPUT_MICROUSD_PER_MILLION=1600000
# $0.02/call and $0.04/attempt by default; raising requires explicit ceilings.
LLM_CALL_MICROUSD=20000
LLM_ATTEMPT_MICROUSD=40000

# Provider: openai | anthropic | fake
LLM_PROVIDER=openai
LLM_ENVIRONMENT=production
LLM_FAKE_ENABLED=false
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=32768
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_CONTEXT_WINDOW=200000
ANTHROPIC_MAX_OUTPUT_TOKENS=64000
ANTHROPIC_DATA_POLICY=
ANTHROPIC_SOURCE_DISCLOSURE_ACKNOWLEDGED=false
ANTHROPIC_INPUT_MICROUSD_PER_MILLION=1000000
ANTHROPIC_OUTPUT_MICROUSD_PER_MILLION=5000000
ANTHROPIC_CALL_MICROUSD=20000
ANTHROPIC_ATTEMPT_MICROUSD=40000
OPENAI_CONTEXT_WINDOW=
OPENAI_DATA_POLICY=
OPENAI_SOURCE_DISCLOSURE_ACKNOWLEDGED=
OPENAI_INPUT_MICROUSD_PER_MILLION=
OPENAI_OUTPUT_MICROUSD_PER_MILLION=
OPENAI_CALL_MICROUSD=
OPENAI_ATTEMPT_MICROUSD=

LLM_CALL_CEILING_MICROUSD=20000
LLM_ATTEMPT_CEILING_MICROUSD=40000
